  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1" },
  "peerDependencies": { "@deepseek-ai/cordis": ">=4.0.1", "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2", "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2", "@deepseek-ai/dsh-skill": ">=0.1.5-rc.2", "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8", "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.8", "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.0-rc.8", "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.8", "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.8", "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8", "react": "^18.2.0" },
